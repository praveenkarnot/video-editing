<?php

/**
 * @file
 * Hooks for the AI Video Studio module.
 */

/**
 * Implements hook_theme().
 */
function ai_video_studio_theme(): array {
  return [
    'ai_video_studio_preview' => [
      'variables' => [
        'video_url' => NULL,
        'job' => NULL,
      ],
    ],
    'ai_video_studio_page' => [
      'variables' => [
        'eyebrow' => NULL,
        'title' => NULL,
        'intro' => NULL,
        'content' => NULL,
      ],
      'template' => 'ai-video-studio-page',
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function ai_video_studio_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'ai_video_studio/studio';
}
