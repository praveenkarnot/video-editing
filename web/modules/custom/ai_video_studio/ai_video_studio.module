<?php

/**
 * @file
 * Hooks for the AI Video Studio module.
 */

/**
 * Implements hook_theme().
 */
function ai_video_studio_theme(): array {
  return [
    'ai_video_studio_preview' => [
      'variables' => [
        'video_url' => NULL,
        'job' => NULL,
      ],
    ],
    'ai_video_studio_page' => [
      'variables' => [
        'eyebrow' => NULL,
        'title' => NULL,
        'intro' => NULL,
        'content' => NULL,
      ],
      'template' => 'ai-video-studio-page',
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function ai_video_studio_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'ai_video_studio/studio';
}

/**
 * Implements hook_preprocess_page().
 */
function ai_video_studio_preprocess_page(array &$variables): void {
  $variables['page']['footer']['ai_video_studio_footer'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => ['class' => ['avs-footer']],
    'brand' => [
      '#markup' => '<div class="avs-footer__brand"><strong>AI Video Studio</strong><span>Premium AI video editing for Drupal.</span></div>',
    ],
    'social' => [
      '#markup' => '<nav class="avs-footer__social" aria-label="Social media"><a href="#" aria-label="LinkedIn">in</a><a href="#" aria-label="X">x</a><a href="#" aria-label="YouTube">yt</a></nav>',
    ],
    'copyright' => [
      '#markup' => '<div class="avs-footer__copy">© 2026 All Rights Reserved.</div>',
    ],
  ];
}
