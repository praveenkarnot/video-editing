{
  "name": "custom/ai-video-studio-site",
  "description": "Drupal site scaffold for an AI video upload, editing, and generation workflow.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "composer/installers": "^2.3",
    "drupal/core-composer-scaffold": "^10.3 || ^11",
    "drupal/core-project-message": "^10.3 || ^11",
    "drupal/core-recommended": "^10.3 || ^11",
    "drush/drush": "^13"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true
    },
    "sort-packages": true
  },
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      }
    },
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
